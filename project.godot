; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="probando los asses y cloros"
run/main_scene="res://scenes/selection/selection_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://Fotos/icon.svg"

[autoload]

GameData="*res://autoload/game_data.gd"
GameState="*res://autoload/game_state.gd"
SoundManager="*res://autoload/sound_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="landscape"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[gui]

theme/custom="uid://3cx15weaeq37"
theme/custom_font="res://fonts/SHPinscher-Regular.otf"

[input]

interactuar={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":69,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
}
"Pulsar "={
"deadzone": 0.2,
"events": []
}

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
